LOCAL_FILES_PATH
EMBEDDING_MODEL_ID
EMBEDDING_SIZE

# Ollama configuration (used when LLM_BASE_URL is not set)
OLLAMA_MODEL

# Custom LLM configuration (OpenAI-compatible API)
# If LLM_BASE_URL is set, Ollama will not be used
LLM_BASE_URL
LLM_MODEL
LLM_API_KEY

RERANKER_MODEL
USER_ID
PASSWORD

# Custom LLM only: allow the agent to send public queries/URLs to the web.
# Keep false for local-document-only use. Never send sensitive content to web tools.
MINIMA_ALLOW_WEB=false
# Default provider after granting web permission; use none to disable.
MINIMA_WEB_SEARCH=parallel
# Optional: explicitly authenticate for higher Parallel limits.
# PARALLEL_API_KEY=
